# Copy to .env at the repository root. Fill secrets before starting Compose.
# Spring Boot also reads this file when launched from the root or backend directory.
# Use plain KEY=value entries without shell commands or surrounding quotes.
SHOPAPP_APP_DB=shopapp_keycloak
SHOPAPP_DB_USERNAME=shopapp
SHOPAPP_DB_PASSWORD=
SHOPAPP_POSTGRES_PORT=5433
SERVER_PORT=8088
SHOPAPP_KEYCLOAK_ADMIN_PASSWORD=
SHOPAPP_KEYCLOAK_SERVICE_SECRET=
SHOPAPP_PUBLIC_BASE_URL=http://localhost:4200
SHOPAPP_VNPAY_ENABLED=false
SHOPAPP_VNPAY_TMN_CODE=
SHOPAPP_VNPAY_HASH_SECRET=
